CF_KEYRING="/usr/share/keyrings/cloudflare-main.gpg"
CF_REPO_FILE="/etc/apt/sources.list.d/cloudflared.list"
CF_BINARY="/data/cloudflared/cloudflared"
CF_SERVICE="cloudflared.service"
CF_TOKEN_FILE="/data/cloudflared/token"

CF_GPG_URL="https://pkg.cloudflare.com/cloudflare-main.gpg"
CF_REPO="deb [signed-by=/usr/share/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared any main"


